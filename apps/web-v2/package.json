{
	"name": "3gulp-app-v2",
	"type": "module",
	"private": true,
	"version": "0.0.0",
	"scripts": {
		"dev": "vite --open",
		"test": "node ./scripts/vitest-runner.mjs",
		"test:ci": "rm -rf coverage && pnpm exec vitest run",
		"lint:tsc": "tsc -b",
		"lint:oxlint": "oxlint --report-unused-disable-directives .",
		"lint": "pnpm run lint:tsc && pnpm run lint:oxlint && pnpm run format:check",
		"format": "oxfmt . --write",
		"format:check": "oxfmt . --check",
		"validate": "pnpm run lint && pnpm run test:ci",
		"build": "vite build",
		"preview": "vite preview"
	},
	"dependencies": {
		"@base-ui/react": "^1.1.0",
		"@stylexjs/stylex": "^0.19.0",
		"@tanstack/react-query": "5.80.6",
		"@tanstack/react-query-devtools": "5.80.6",
		"@tanstack/react-router": "1.131.27",
		"lucide-react": "^0.525.0",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-error-boundary": "6.0.0"
	},
	"devDependencies": {
		"@stylexjs/unplugin": "^0.19.0",
		"@tanstack/react-router-devtools": "^1.131.27",
		"@tanstack/router-plugin": "1.131.27",
		"@testing-library/dom": "10.4.0",
		"@testing-library/jest-dom": "6.6.3",
		"@testing-library/react": "16.3.0",
		"@testing-library/user-event": "14.6.1",
		"@types/node": "22.15.30",
		"@types/react": "19.1.6",
		"@types/react-dom": "19.1.6",
		"@vitejs/plugin-react": "4.5.1",
		"@vitest/coverage-v8": "3.2.2",
		"eslint-plugin-simple-import-sort": "^13.0.0",
		"happy-dom": "17.6.3",
		"oxfmt": "^0.56.0",
		"oxlint": "^1.71.0",
		"typescript": "5.8.3",
		"vite": "6.3.5",
		"vite-tsconfig-paths": "5.1.4",
		"vitest": "3.2.2"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"packageManager": "pnpm@10.15.1"
}

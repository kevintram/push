{
	"name": "3gulp-app-v2",
	"type": "module",
	"private": true,
	"version": "0.0.0",
	"scripts": {
		"dev": "vite --open",
		"test": "node ./scripts/vitest-runner.mjs",
		"test:ci": "rm -rf coverage && pnpm exec vitest run",
		"lint:tsc": "tsc -b",
		"lint:eslint": "eslint .",
		"lint:component-count": "node ./scripts/check-component-count.mjs",
		"lint": "node ./scripts/run-lint.mjs",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"validate": "pnpm run lint && pnpm run test:ci",
		"build": "vite build",
		"preview": "vite preview"
	},
	"dependencies": {
		"@base-ui/react": "^1.1.0",
		"@tanstack/react-query": "5.80.6",
		"@tanstack/react-query-devtools": "5.80.6",
		"@tanstack/react-router": "1.131.27",
		"@vanilla-extract/css": "^1.17.4",
		"@vanilla-extract/recipes": "^0.5.7",
		"clsx": "^2.1.1",
		"lucide-react": "^0.525.0",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-error-boundary": "6.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.23.0",
		"@tanstack/react-router-devtools": "^1.131.27",
		"@tanstack/router-plugin": "1.131.27",
		"@testing-library/dom": "10.4.0",
		"@testing-library/jest-dom": "6.6.3",
		"@testing-library/react": "16.3.0",
		"@testing-library/user-event": "14.6.1",
		"@types/node": "22.15.30",
		"@types/react": "19.1.6",
		"@types/react-dom": "19.1.6",
		"@vanilla-extract/vite-plugin": "^5.1.1",
		"@vitejs/plugin-react": "4.5.1",
		"@vitest/coverage-v8": "3.2.2",
		"eslint": "^9.23.0",
		"eslint-plugin-react": "^7.37.4",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.19",
		"eslint-plugin-simple-import-sort": "^13.0.0",
		"globals": "^17.7.0",
		"happy-dom": "17.6.3",
		"prettier": "^3.6.2",
		"typescript": "5.8.3",
		"typescript-eslint": "^8.27.0",
		"vite": "6.3.5",
		"vite-tsconfig-paths": "5.1.4",
		"vitest": "3.2.2"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"packageManager": "pnpm@10.15.1"
}

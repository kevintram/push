{
	"name": "3gulp-app-v2",
	"type": "module",
	"private": true,
	"version": "0.0.0",
	"scripts": {
		"dev": "vite --open",
		"test": "vitest",
		"test:ci": "rm -rf coverage && pnpm exec vitest run",
		"lint:tsc": "tsc -b",
		"lint:oxlint": "oxlint --report-unused-disable-directives .",
		"lint": "pnpm run lint:tsc && pnpm run lint:oxlint && pnpm run format:check",
		"format": "oxfmt . --write",
		"format:check": "oxfmt . --check",
		"validate": "pnpm run lint && pnpm run test:ci",
		"build": "vite build",
		"preview": "vite preview"
	},
	"dependencies": {
		"@base-ui/react": "^1.1.0",
		"@stylexjs/stylex": "^0.19.0",
		"@tanstack/react-router": "1.170.16",
		"@workos-inc/authkit-react": "^0.16.1",
		"convex": "^1.42.3",
		"date-fns": "^4.4.0",
		"lucide-react": "^0.525.0",
		"react": "19.1.0",
		"react-day-picker": "^9.14.0",
		"react-dom": "19.1.0",
		"react-error-boundary": "6.0.0",
		"sonner": "^2.0.7"
	},
	"devDependencies": {
		"@stylexjs/eslint-plugin": "^0.19.0",
		"@stylexjs/unplugin": "^0.19.0",
		"@tanstack/eslint-plugin-router": "^1.162.0",
		"@tanstack/react-router-devtools": "^1.167.0",
		"@tanstack/router-plugin": "1.168.18",
		"@testing-library/dom": "10.4.0",
		"@testing-library/jest-dom": "6.6.3",
		"@testing-library/react": "16.3.0",
		"@testing-library/user-event": "14.6.1",
		"@types/node": "22.15.30",
		"@types/react": "19.1.6",
		"@types/react-dom": "19.1.6",
		"@vitejs/plugin-react": "6.0.3",
		"@vitest/coverage-v8": "4.1.9",
		"eslint-plugin-simple-import-sort": "^13.0.0",
		"happy-dom": "17.6.3",
		"oxfmt": "^0.56.0",
		"oxlint": "^1.71.0",
		"typescript": "5.8.3",
		"unplugin": "2.3.11",
		"vite": "8.1.0",
		"vitest": "4.1.9"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"packageManager": "pnpm@10.15.1"
}

{
	"arrowParens": "avoid",
	"bracketSpacing": true,
	"jsxSingleQuote": true,
	"printWidth": 80,
	"semi": false,
	"singleQuote": true,
	"tabWidth": 4,
	"trailingComma": "all",
	"useTabs": true,
	"sortPackageJson": false,
	"ignorePatterns": [

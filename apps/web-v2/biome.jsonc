{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": { "clientKind": "git", "enabled": true, "useIgnoreFile": true },
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on",
				"useSortedAttributes": "on",
				"useSortedProperties": "on"
			}
		},
		"enabled": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"files": {
		"includes": ["**/*", "!**/routeTree.gen.ts"]
	},
	"javascript": {
		"formatter": {
			"arrowParentheses": "asNeeded",
			"bracketSpacing": true,
			"jsxQuoteStyle": "single",
			"quoteStyle": "single",
			"semicolons": "asNeeded",
			"trailingCommas": "none"
		}
	},
	"linter": {
		"domains": {
			"project": "all",
			"react": "all",
			"test": "all"
		},
		"enabled": true,
		"rules": {
			"a11y": "warn",
			"complexity": "warn",
			"correctness": "warn",
			"nursery": "warn",
			"performance": "warn",
			"recommended": true,
			"security": "warn",
			"style": "warn",
			"suspicious": "warn"
		}
	},
	"overrides": [
		{
			"includes": ["src/**/*.tsx", "!src/**/*.test.tsx"],
			"linter": {
				"rules": {
					"nursery": {
						"noExcessiveLinesPerFile": {
							"level": "error",
							"options": {
								"maxLines": 500,
								"skipBlankLines": true
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/*"],
			"linter": {
				"rules": {
					"correctness": {
						"useImportExtensions": "off",
						"noUndeclaredDependencies": "off",
						"useExhaustiveDependencies": {
							"level": "warn",
							"fix": "none"
						}
					},
					"nursery": {
						"useExplicitType": "off",
						"noShadow": "off"
					},
					"suspicious": {
						"noReactSpecificProps": "off",
						"noEmptyBlockStatements": "off"
					},
					"complexity": {
						"noExcessiveCognitiveComplexity": "off",
						"noExcessiveNestedTestSuites": "off"
					},
					"performance": {
						"noImgElement": "off",
						"noNamespaceImport": "off",
						"noBarrelFile": "off"
					},
					"style": {
						"useComponentExportOnlyModules": "off",
						"useConsistentArrayType": {
							"level": "error",
							"options": {
								"syntax": "generic"
							},
							"fix": "safe"
						},
						"useFilenamingConvention": {
							"level": "error",
							"options": {
								"strictCase": false,
								"requireAscii": true,
								"filenameCases": ["camelCase", "kebab-case", "PascalCase"]
							}
						},
						"useBlockStatements": "off",
						"noDefaultExport": "off",
						"noNonNullAssertion": "off"
					}
				}
			}
		},
		{
			"includes": ["vite.config.ts", "scripts/**/*.mjs"],
			"linter": {
				"rules": {
					"correctness": {
						"noNodejsModules": "off"
					}
				}
			}
		},
		{
			"includes": ["src/**/*.test.tsx"],
			"linter": {
				"rules": {
					"performance": {
						"useTopLevelRegex": "off"
					},
					"suspicious": {
						"noExplicitAny": "off",
						"noThenProperty": "off"
					}
				}
			}
		}
	]
}

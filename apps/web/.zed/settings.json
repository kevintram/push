{
	"languages": {
		"JavaScript": {
			"format_on_save": "on",
			"tab_size": 4,
			"hard_tabs": true,
			"formatter": {
				"external": {
					"command": "pnpm",
					"arguments": [
						"exec",
						"oxfmt",
						"--stdin-filepath",
						"{buffer_path}"
					]
				}
			}
		},

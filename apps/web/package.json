{
	"name": "3gulp-app",
	"type": "module",
	"private": true,
	"version": "0.0.0",
	"scripts": {
		"dev": "vite --open",
		"test": "node ./scripts/vitest-runner.mjs",
		"test:e2e": "pnpm exec playwright test --ui",
		"test:ci": "rm -rf coverage && pnpm exec vitest run",
		"test:e2e:ci": "pnpm exec playwright test",
		"lint:tsc": "tsc -b",
		"lint:oxlint": "oxlint --report-unused-disable-directives .",
		"lint": "pnpm run lint:tsc && pnpm run lint:oxlint && pnpm run format:check",
		"format": "oxfmt . --write",
		"format:check": "oxfmt . --check",
		"validate": "pnpm run lint && pnpm run test:ci && pnpm run test:e2e:ci",
		"build": "vite build",
		"preview": "vite preview"
	},
	"dependencies": {
		"@base-ui/react": "^1.1.0",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/modifiers": "^9.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@lucide/lab": "^0.1.2",
		"@tanstack/react-query": "5.80.6",
		"@tanstack/react-query-devtools": "5.80.6",
		"@tanstack/react-router": "1.131.27",
		"@tanstack/react-virtual": "^3.13.12",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.1.0",
		"dayjs": "^1.11.18",
		"framer-motion": "^12.23.22",
		"js-cookie": "^3.0.5",
		"lodash.debounce": "^4.0.8",
		"lucide-react": "^0.525.0",
		"next-themes": "^0.4.6",
		"react": "19.1.0",
		"react-day-picker": "^9.13.2",
		"react-dom": "19.1.0",
		"react-error-boundary": "6.0.0",
		"react-resizable-panels": "^3.0.4",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.3.1",
		"valibot": "1.1.0"
	},
	"devDependencies": {
		"@playwright/test": "1.58.2",
		"@tailwindcss/vite": "4.1.8",
		"@tanstack/react-router-devtools": "^1.127.3",
		"@tanstack/router-plugin": "1.131.27",
		"@testing-library/dom": "10.4.0",
		"@testing-library/jest-dom": "6.6.3",
		"@testing-library/react": "16.3.0",
		"@testing-library/user-event": "14.6.1",
		"@types/jest": "^30.0.0",
		"@types/js-cookie": "^3.0.6",
		"@types/lodash.debounce": "^4.0.9",
		"@types/node": "22.15.30",
		"@types/react": "19.1.6",
		"@types/react-dom": "19.1.6",
		"@vitejs/plugin-react": "4.5.1",
		"@vitest/coverage-v8": "3.2.2",
		"eslint-plugin-simple-import-sort": "^13.0.0",
		"happy-dom": "17.6.3",
		"msw": "2.10.1",
		"oxfmt": "^0.56.0",
		"oxlint": "^1.71.0",
		"tailwindcss": "4.1.8",
		"tw-animate-css": "^1.3.5",
		"typescript": "5.8.3",
		"vite": "6.3.5",
		"vite-tsconfig-paths": "5.1.4",
		"vitest": "3.2.2"
	},
	"pnpm": {
		"ignoredBuiltDependencies": [
			"core-js-pure",
			"cypress"
		],
		"onlyBuiltDependencies": [
			"@tailwindcss/oxide",
			"esbuild",
			"msw"
		]
	},
	"packageManager": "pnpm@10.15.1",
	"msw": {
		"workerDirectory": [
			"public"
		]
	}
}

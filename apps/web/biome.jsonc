{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": { "clientKind": "git", "enabled": true, "useIgnoreFile": true },
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on",
				"useSortedAttributes": "on",
				"useSortedProperties": "on"
			}
		},
		"enabled": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"files": {
		"includes": ["**/*", "!**/routeTree.gen.ts", "!**/types/database.types.ts"]
	},
	"javascript": {
		"formatter": {
			"arrowParentheses": "asNeeded",
			"bracketSpacing": true,
			"jsxQuoteStyle": "single",
			"quoteStyle": "single",
			"semicolons": "asNeeded",
			"trailingCommas": "none"
		}
	},
	"linter": {
		"domains": {
			"project": "all",
			"react": "all",
			"test": "all"
		},
		"enabled": true,
		"rules": {
			"a11y": "warn",
			"complexity": "warn",
			"correctness": "warn",
			"nursery": "warn",
			"performance": "warn",
			"recommended": true,
			"security": "warn",
			"style": "warn",
			"suspicious": "warn"
		}
	},
	"overrides": [
		{
			"includes": ["**/*"],
			"linter": {
				"rules": {
					"correctness": {
						"useImportExtensions": "off",
						"noUndeclaredDependencies": "off",
						"useExhaustiveDependencies": {
							"level": "warn",
							"fix": "none"
						}
					},
					"nursery": {
						"noUnresolvedImports": "off",
						"noUnknownAtRule": "off",
						"useExplicitType": "off",
						"useForComponent": "off",
						"useExportsLast": "off",
						"noShadow": "off",
						"useSortedClasses": {
							"level": "error",
							"fix": "safe"
						}
					},
					"suspicious": {
						"noReactSpecificProps": "off",
						"noArrayIndexKey": "off",
						"noEmptyBlockStatements": "off"
					},
					"complexity": {
						"noExcessiveCognitiveComplexity": "off",
						"noExcessiveNestedTestSuites": "off"
					},
					"performance": {
						"noImgElement": "off",
						"noNamespaceImport": "off",
						"noBarrelFile": "off"
					},
					"style": {
						// turn off while we use supabase typing
						// TODO: turn this back on when/if we start using proper backend API
						"useNamingConvention": {
							"level": "off",
							"options": {
								"strictCase": false,
								"requireAscii": true
							}
						},
						"noExportedImports": "off",
						"useComponentExportOnlyModules": "off",
						"useConsistentArrayType": {
							"level": "error",
							"options": {
								"syntax": "generic"
							},
							"fix": "safe"
						},
						"useFilenamingConvention": {
							"level": "error",
							"options": {
								"strictCase": false,
								"requireAscii": true,
								"filenameCases": ["camelCase", "kebab-case", "PascalCase"]
							}
						},
						"useBlockStatements": "off",
						"noNonNullAssertion": "off"
					}
				}
			}
		},
		{
			"includes": ["vite.config.ts", "playwright.config.ts"],
			"linter": {
				"rules": {
					"correctness": {
						"noNodejsModules": "off"
					},
					"style": {
						"noDefaultExport": "off"
					}
				}
			}
		},
		{
			"includes": ["src/**/*.test.tsx"],
			"linter": {
				"rules": {
					"performance": {
						"useTopLevelRegex": "off"
					},
					"suspicious": {
						"noExplicitAny": "off",
						"noThenProperty": "off"
					}
				}
			}
		},
		{
			"includes": ["src/components/ui/**"],
			"linter": {
				"rules": {
					"style": {
						"useComponentExportOnlyModules": "off" // because it causes issues with shadcn, see 1. https://github.com/shadcn-ui/ui/issues/7736 2. https://github.com/ArnaudBarre/eslint-plugin-react-refresh/issues/843. https://github.com/shadcn-ui/ui/issues/1534
					},
					"suspicious": {
						"noDocumentCookie": "off" // because who cares
					},
					"nursery": {
						"noSecrets": "off" // because it's causing issues with tailwind
					}
				}
			}
		},
		{
			"includes": ["src/app/routes/**"],
			"linter": {
				"rules": {
					"style": {
						"useFilenamingConvention": "off", // cause it doesn't support Tanstack's dynamic routes yet
						"useComponentExportOnlyModules": "off" // cause only routes are exported (never components)
					}
				}
			}
		},

		{
			"includes": ["public/**"],
			"formatter": {
				"enabled": false
			},
			"linter": {
				"enabled": false
			}
		}
	]
}

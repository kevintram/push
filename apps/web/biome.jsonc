{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": { "clientKind": "git", "enabled": true, "useIgnoreFile": true },
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on",
				"useSortedAttributes": "on",
				"useSortedProperties": "on"
			}
		},
		"enabled": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"files": {
		"includes": ["**/*", "!**/routeTree.gen.ts", "!**/types/database.types.ts"]
	},
	"javascript": {
		"formatter": {
			"arrowParentheses": "asNeeded",
			"bracketSpacing": true,
			"jsxQuoteStyle": "single",
			"quoteStyle": "single",
			"semicolons": "asNeeded",
			"trailingCommas": "none"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"domains": {
			"project": "all",
			"react": "all",
			"test": "all"
		},
		"enabled": true,
		"rules": {
			"a11y": "warn",
			"complexity": "warn",
			"correctness": "warn",
			"nursery": "warn",
			"performance": "warn",
			"recommended": true,
			"security": "warn",
			"style": "warn",
			"suspicious": "warn"
		}
	},
	"overrides": [
		{
			"includes": [
				"src/**/*.tsx",
				"!src/**/*.test.tsx",
				"!src/components/ui/**"
			],
			"linter": {
				"rules": {
					"nursery": {
						"noExcessiveLinesPerFile": {
							"level": "error",
							"options": {
								"maxLines": 500,
								"skipBlankLines": true
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/*"],
			"linter": {
				"rules": {
					"correctness": {
						"useImportExtensions": "off",
						"noUndeclaredDependencies": "off",
						"useExhaustiveDependencies": {
							"level": "warn",
							"fix": "none"
						}
					},
					"nursery": {
						"useExplicitType": "off",
						"noShadow": "off",
						"useSortedClasses": {
							"level": "error",
							"fix": "safe"
						}
					},
					"suspicious": {
						"noReactSpecificProps": "off",
						"noArrayIndexKey": "off",
						"noEmptyBlockStatements": "off"
					},
					"complexity": {
						"noExcessiveCognitiveComplexity": "off",
						"noExcessiveNestedTestSuites": "off"
					},
					"performance": {
						"noImgElement": "off",
						"noNamespaceImport": "off",
						"noBarrelFile": "off"
					},
					"style": {
						// turn off while we use supabase typing
						// TODO: turn this back on when/if we start using proper backend API
						"useNamingConvention": {
							"level": "off",
							"options": {
								"strictCase": false,
								"requireAscii": true
							}
						},
						"noExportedImports": "off",
						"useComponentExportOnlyModules": "off",
						"useConsistentArrayType": {
							"level": "error",
							"options": {
								"syntax": "generic"
							},
							"fix": "safe"
						},
						"useFilenamingConvention": {
							"level": "error",
							"options": {
								"strictCase": false,
								"requireAscii": true,
								"filenameCases": ["camelCase", "kebab-case", "PascalCase"]
							}
						},
						"useBlockStatements": "off",
						"noNonNullAssertion": "off"
					}
				}
			}
		},
		{
			"includes": ["vite.config.ts", "playwright.config.ts"],
			"linter": {
				"rules": {
					"correctness": {
						"noNodejsModules": "off"
					},
					"style": {
						"noDefaultExport": "off"
					}
				}
			}
		},
		{
			"includes": ["scripts/**/*.mjs"],
			"linter": {
				"rules": {
					"correctness": {
						"noNodejsModules": "off"
					}
				}
			}
		},
		{
			"includes": ["src/**/*.test.tsx"],
			"linter": {
				"rules": {
					"performance": {
						"useTopLevelRegex": "off"
					},
					"suspicious": {
						"noExplicitAny": "off",
						"noThenProperty": "off"
					}
				}
			}
		},
		{
			"includes": ["src/components/ui/**"],
			"javascript": {
				"formatter": {
					"quoteStyle": "double"
				}
			},
			"linter": {
				"rules": {
					"correctness": {
						"noUndeclaredVariables": "off"
					},
					"style": {
						"useComponentExportOnlyModules": "off" // because it causes issues with shadcn, see 1. https://github.com/shadcn-ui/ui/issues/7736 2. https://github.com/ArnaudBarre/eslint-plugin-react-refresh/issues/843. https://github.com/shadcn-ui/ui/issues/1534
					},
					"suspicious": {
						"noDocumentCookie": "off" // because who cares
					},
					"a11y": {
						"noLabelWithoutControl": "off",
						"useKeyWithClickEvents": "off"
					},
					"nursery": {
						"useSortedClasses": "off"
					}
				}
			}
		},
		{
			"includes": ["src/app/pages/ReviewPage.tsx"],
			"linter": {
				"rules": {
					"style": {
						"noNestedTernary": "off",
						"useDefaultSwitchClause": "off"
					}
				}
			}
		},
		{
			"includes": ["src/app/pages/UnscheduledPage.tsx"],
			"linter": { "rules": {} }
		},
		{
			"includes": ["src/components/LearnableCard/LearnableCardBase.tsx"],
			"linter": {
				"rules": {
					"style": {
						"noNestedTernary": "off"
					},
					"a11y": {
						"useSemanticElements": "off",
						"useFocusableInteractive": "off",
						"noStaticElementInteractions": "off"
					}
				}
			}
		},
		{
			"includes": ["src/components/ReviewsSidebar/ReviewsSidebar.tsx"],
			"linter": {
				"rules": {
					"style": {
						"noNestedTernary": "off"
					},
					"suspicious": {
						"noImplicitAnyLet": "off",
						"noEvolvingTypes": "off"
					}
				}
			}
		},
		{
			"includes": [
				"src/components/icons/BookOpenOff.tsx",
				"src/components/icons/SquarePlusBottomRight.tsx"
			],
			"linter": {
				"rules": {
					"a11y": {
						"noSvgWithoutTitle": "off"
					}
				}
			}
		},
		{
			"includes": ["src/components/ui/calendar.tsx"],
			"linter": { "rules": {} }
		},
		{
			"includes": ["src/app/routes/**"],
			"linter": {
				"rules": {
					"style": {
						"useFilenamingConvention": "off", // cause it doesn't support Tanstack's dynamic routes yet
						"useComponentExportOnlyModules": "off" // cause only routes are exported (never components)
					}
				}
			}
		},

		{
			"includes": ["public/**"],
			"formatter": {
				"enabled": false
			},
			"linter": {
				"enabled": false
			}
		}
	]
}

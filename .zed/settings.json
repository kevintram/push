{
	"auto_install_extensions": {
		"oxc": true,
		"tailwindcss": true
	},
	"lsp": {
		"oxlint": {
			"initialization_options": {
				"settings": {
					"configPath": null,
					"disableNestedConfig": false,
					"fixKind": "safe_fix_or_suggestion",
					"run": "onSave"
				}
			}
		},
		"oxfmt": {
			"initialization_options": {
				"settings": {
					"fmt.configPath": null,
					"run": "onSave"
				}
			}
		}
	},
	"languages": {
		"JavaScript": {
			"format_on_save": "on",
			"code_actions_on_format": {
				"source.fixAll.oxc": true
			},
			"prettier": { "allowed": false },
			"formatter": { "language_server": { "name": "oxfmt" } }
		},
		"TypeScript": {
			"format_on_save": "on",
			"code_actions_on_format": {
				"source.fixAll.oxc": true
			},
			"prettier": { "allowed": false },
			"formatter": { "language_server": { "name": "oxfmt" } }
		},
		"TSX": {
			"format_on_save": "on",
			"code_actions_on_format": {
				"source.fixAll.oxc": true
			},
			"prettier": { "allowed": false },
			"formatter": { "language_server": { "name": "oxfmt" } }
		},
		"CSS": {
			"format_on_save": "on",
			"prettier": { "allowed": false },
			"formatter": [{ "language_server": { "name": "oxfmt" } }]
		},
		"JSON": {
			"format_on_save": "on",
			"prettier": { "allowed": false },
			"formatter": [{ "language_server": { "name": "oxfmt" } }]
		},
		"JSONC": {
			"format_on_save": "on",
			"prettier": { "allowed": false },
			"formatter": [{ "language_server": { "name": "oxfmt" } }]
		}
	}
}
